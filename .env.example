# Single-tenant credential (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load this. Do not add it to
# that service's environment or via env_file.
CREWHU_API_TOKEN=

# stdio (default) or http
MCP_TRANSPORT=stdio

# gateway: require X-Crewhu-Api-Token on each /mcp request. Never falls back
#          to CREWHU_API_TOKEN. Docker image and Compose default.
# env:     use CREWHU_API_TOKEN after X-Gateway-S2S verifies.
# AUTH_MODE=gateway

# Required to start the HTTP transport. Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (so a copied
# example cannot forge X-Gateway-S2S). docker compose will not start if it
# is unset or empty. Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The process logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 even if MCP_HTTP_HOST is a wider address such as 0.0.0.0.
# A known placeholder secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when MCP_TRANSPORT=http. Defaults to 127.0.0.1.
# Honored only when CONDUIT_S2S_SECRET is a real secret. The container image
# sets 0.0.0.0.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

LOG_LEVEL=info
